@model PaginatedList<MyLibrary.Domain.Entities.Author>
@await Html.PartialAsync("~/Views/Shared/_DeleteModal.cshtml")

@{
    ViewData["Title"] = "Авторы";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="book-data-zagolovok">@ViewData["Title"]</h2>
        <a asp-action="Create"
           class="btn btn-sm btn-success me-2"
           title="Добавить нового автора"
           data-bs-toggle="tooltip"
           data-bs-placement="top">
            <i class="bi bi-plus-lg"></i> Добавить автора
        </a>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Пока нет ни одного автора. Добавьте первого!
        </div>
    }
    else
    {
        <!-- Обертка для скругления -->
        <div class="rounded-table-wrapper">
            <table class="table table-hover mb-0">
                <thead class="table-primary">
                    <tr>
                        <th>Имя автора</th>
                        <th class="text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var author in Model)
                    {
                        <tr>
                            <td class="fw-bold">@author.DisplayName</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@author.AuthorID" class="btn btn-sm btn-warning me-1" title="Редактировать автора"><i class="bi bi-pencil"></i> Редактировать</a>
                                <button type="button"
                                        class="btn btn-sm btn-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal"
                                        data-item-id="@author.AuthorID"
                                        data-item-name="@author.DisplayName">
                                    <i class="bi bi-trash"></i> Удалить
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Постраничная навигация" class="mt-3">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@(Model.PageIndex - 1)">‹ Назад</a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@(Model.PageIndex + 1)">Вперёд ›</a>
                        </li>
                    </ul>
                </nav>
            }

        </div>

    }
</div>

<script src="~/js/common-delete-modal.js"></script>


