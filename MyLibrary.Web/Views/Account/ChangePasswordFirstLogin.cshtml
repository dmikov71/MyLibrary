@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Смена пароля при первом входе";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">Установите постоянный пароль</h4>
                </div>
                <div class="card-body">
                    <p class="text-muted small">Это обязательная процедура при первом входе. После этого вы сможете работать в системе.</p>

                    <form asp-action="ChangePasswordFirstLogin" method="post">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label">Текущий (временный) пароль</label>
                            <input asp-for="CurrentPassword" class="form-control" type="password" autofocus />
                            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label">Новый пароль</label>
                            <input asp-for="NewPassword" class="form-control" type="password" />
                            <small class="text-muted">Минимум 8 символов, минимум одна большая буква</small>
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">Подтверждение пароля</label>
                            <input asp-for="ConfirmPassword" class="form-control" type="password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-warning w-100">Установить пароль</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
