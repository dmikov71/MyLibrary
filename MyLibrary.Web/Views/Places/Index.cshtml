@model IEnumerable<MyLibrary.Domain.Entities.Place>
@await Html.PartialAsync("~/Views/Shared/_DeleteModal.cshtml")


@{
    ViewData["Title"] = "Места хранения книг";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="book-data-zagolovok">@ViewData["Title"]</h2>
        <a asp-action="Create"
           class="btn btn-sm btn-success me-2"
           title="Добавить новое место"
           data-bs-toggle="tooltip"
           data-bs-placement="top">
            <i class="bi bi-plus-lg"></i> Добавить место
        </a>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Пока нет ни одного места хранения книг. Добавьте первое!
        </div>
    }
    else
    {
        <!-- Обертка для скругления -->
        <div class="rounded-table-wrapper">
            <table class="table table-hover mb-0">
                <thead class="table-primary">
                    <tr>
                        <th>Название места хранения</th>
                        <th class="text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var place in Model)
                    {
                        <tr>
                            <td class="fw-bold">@place.Name</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@place.PlaceID" class="btn btn-sm btn-warning me-1" title="Редактировать место"><i class="bi bi-pencil"></i> Редактировать</a>
                                <button type="button"
                                        class="btn btn-sm btn-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal"
                                        data-item-id="@place.PlaceID"
                                        data-item-name="@place.Name">
                                    <i class="bi bi-trash"></i> Удалить
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    }
</div>

<script src="~/js/common-delete-modal.js"></script>



