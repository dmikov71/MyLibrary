@model MyLibrary.Domain.Entities.Place

@{
    ViewData["Title"] = "Редактировать место хранения книг";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">Редактирование места хранения: @Model.Name</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="PlaceID" />

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Название места хранения</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 d-md-block">
                            <button type="submit" class="btn btn-warning btn-sm"><i class="bi bi-save"></i> Сохранить изменения</button>
                            <a asp-action="Index" class="btn btn-secondary btn-sm">Отмена</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


