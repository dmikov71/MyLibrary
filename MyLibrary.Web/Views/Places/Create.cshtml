@model MyLibrary.Domain.Entities.Place

@{
    ViewData["Title"] = "Добавить место хранения";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">@ViewData["Title"]</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Название места хранения</label>
                            <input asp-for="Name" class="form-control" placeholder="Например: книжный шкаф" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 d-md-block">
                            <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-save"></i> Сохранить</button>
                            <a asp-action="Index" class="btn btn-secondary btn-sm">Отмена</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

