@{
    ViewData["Title"] = "Главная";
}

<div class="container mt-5">
    <div class="text-center">
        <h2 class="home-title">Добро пожаловать в приложение </h2> 
        <h1 class="home-title">"Моя библиотека"</h1>
        <p class="text-muted mt-4 fs-5">Система для ведения каталога печатных и электронных книг</p>

        <div class="d-flex justify-content-center gap-3 mt-5">
            @if (User.Identity is { IsAuthenticated: true })
            {
                <a asp-controller="Books" asp-action="Index" class="btn btn-primary btn-lg px-5 py-3">
                    <i class="bi bi-book me-2"></i>Обзор каталога книг
                </a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-5 py-3">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Войти
                </a>
                <a asp-controller="Books" asp-action="Index" class="btn btn-primary btn-lg px-5 py-3">
                    <i class="bi bi-book me-2"></i>Обзор каталога книг
                </a>
            }
        </div>
    </div>
</div>

