@model IEnumerable<MyLibrary.Domain.Entities.Category>
@await Html.PartialAsync("~/Views/Shared/_DeleteModal.cshtml")

@{
    ViewData["Title"] = "Категории";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="book-data-zagolovok">@ViewData["Title"]</h2>
        <a asp-action="Create"
           class="btn btn-sm btn-success me-2"
           title="Добавить новую категорию"
           data-bs-toggle="tooltip"
           data-bs-placement="top">
            <i class="bi bi-plus-lg"></i> Добавить категорию
        </a>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Пока нет ни одной категории. Добавьте первую!
        </div>
    }
    else
    {
        <!-- Обертка для скругления -->
        <div class="rounded-table-wrapper">
            <table class="table table-hover mb-0">
                <thead class="table-primary">
                    <tr>
                        <th>Код категории</th>
                        <th>Название категории</th>                        
                        <th class="text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td class="fw-bold">@category.Code</td>
                            <td class="fw-bold">@category.Name</td>                         
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@category.CategoryID" class="btn btn-sm btn-warning me-1" title="Редактировать категорию"><i class="bi bi-pencil"></i> Редактировать</a>
                                <button type="button"
                                        class="btn btn-sm btn-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal"
                                        data-item-id="@category.CategoryID"
                                        data-item-name="@category.Name">
                                    <i class="bi bi-trash"></i> Удалить
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<script src="~/js/common-delete-modal.js"></script>

